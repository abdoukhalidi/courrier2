<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Groupe Gestionnaires -->
        <record id="group_axa_mail_manager" model="res.groups">
            <field name="name">Gestionnaires</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="comment">Accès à vue globale avec tendances et alertes</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Groupe Coursiers -->
        <record id="group_axa_coursier" model="res.groups">
            <field name="name">Coursiers</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="comment">Suivi en temps réel des livraisons et performances individuelles</field>
        </record>

        <!-- Groupe Destinataires -->
        <record id="group_axa_destinataire" model="res.groups">
            <field name="name">Destinataires</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="comment">Historique des réceptions et statuts des courriers</field>
        </record>
    </data>
</odoo>