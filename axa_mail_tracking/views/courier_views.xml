<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulaire Suivi Courrier -->
    <record id="view_axa_mail_tracking_form" model="ir.ui.view">
        <field name="name">axa.mail.tracking.form</field>
        <field name="model">axa.mail.tracking</field>
        <field name="arch" type="xml">
           <form>
    <header>
        <button name="action_validate" string="Valider" type="object" class="oe_highlight"
                invisible="state != 'draft'"/>
        <button name="action_reject" string="Rejeter" type="object"
                invisible="state != 'draft'"/>
        <button name="action_dispatch" string="Distribuer" type="object" class="btn-primary"
                invisible="state != 'received'"/>
        <field name="state" widget="statusbar"
               statusbar_visible="draft,received,dispatched,done"
               statusbar_colors='{"rejected":"red"}'/>
    </header>
    <sheet>
        <div class="oe_title"><h1><field name="name" readonly="1" class="oe_inline"/></h1></div>
        <group>
            <group>
                <field name="mail_type"/>
                <field name="sender"/>
                <field name="recipient_id"/>
                <field name="date_received"/>
            </group>
            <group>
                <field name="qr_code" widget="image" class="oe_avatar"/>
            </group>
        </group>
        <notebook>
            <page string="Document">
                <field name="attachment" widget="binary" filename="attachment_fname"
                       options='{"preview": true}'/>
            </page>
            <page string="Historique de Distribution">
                <field name="dispatch_history">
                    <list>
                        <field name="timestamp"/>
                        <field name="user_id"/>
                        <field name="action"/>
                        <field name="notes"/>
                    </list>
                </field>
            </page>
            <page string="Rejet" invisible="state != 'rejected'">
                <field name="rejection_reason"/>
            </page>
        </notebook>
    </sheet>
</form>
        </field>
    </record>

    <!-- Liste Suivi Courrier -->
    <record id="view_axa_mail_tracking_tree" model="ir.ui.view">
        <field name="name">axa.mail.tracking.tree</field>
        <field name="model">axa.mail.tracking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mail_type"/>
                <field name="sender"/>
                <field name="recipient_id"/>
                <field name="date_received"/>
                <field name="state" widget="badge" decoration-danger="state == 'rejected'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Recherche Suivi Courrier -->
    <record id="view_axa_mail_tracking_search" model="ir.ui.view">
        <field name="name">axa.mail.tracking.search</field>
        <field name="model">axa.mail.tracking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="[('name','ilike',self)]"/>
                <field name="mail_type"/>
                <field name="recipient_id"/>
                <filter string="À recevoir" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Reçus" name="received" domain="[('state','=','received')]"/>
                <filter string="Rejetés" name="rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="today" domain="[('date_received','>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
            </search>
        </field>
    </record>

    <!-- Action Principale -->
    <record id="action_axa_mail_tracking" model="ir.actions.act_window">
        <field name="name">Suivi des Courriers AXA</field>
        <field name="res_model">axa.mail.tracking</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer un nouveau courrier
            </p>
        </field>
    </record>

    <!-- Menu Principal -->
    <menuitem id="menu_axa_mail_tracking_root" name="Courriers AXA" sequence="10"/>
    <menuitem
        id="menu_axa_mail_tracking"
        name="Suivi Courriers"
        parent="menu_axa_mail_tracking_root"
        action="action_axa_mail_tracking"
        sequence="10"/>

    <!-- Historique de Distribution (sous-menu) -->
    <record id="action_axa_dispatch_history" model="ir.actions.act_window">
        <field name="name">Historique de Distribution</field>
        <field name="res_model">axa.dispatch.history</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_axa_dispatch_history"
        name="Historique Distribution"
        parent="menu_axa_mail_tracking_root"
        action="action_axa_dispatch_history"
        sequence="20"/>
</odoo>