<!-- views/reporting_views.xml -->

<odoo>
<record id="view_mail_tracking_graph" model="ir.ui.view">
    <field name="name">axa.mail.tracking.graph</field>
    <field name="model">axa.mail.tracking</field>
    <field name="arch" type="xml">
        <graph string="Statistiques Courriers">
            <field name="date_received" interval="day" type="row"/>
            <field name="state" type="measure"/>
        </graph>
    </field>
</record>

<record id="action_mail_tracking_dashboard" model="ir.actions.act_window">
    <field name="name">Tableau de Bord Courriers</field>
    <field name="res_model">axa.mail.tracking</field>
    <field name="view_mode">graph,pivot,form</field>
    <field name="view_id" ref="view_mail_tracking_graph"/>
</record>
    </odoo>